# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_secure_password
DATABASE_URL=jdbc:postgresql://localhost:5432/eldercare360
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_this_secure_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_256_bits_long_for_hs256

# ── Storage ───────────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=./uploads/medical-documents

# ── Service URLs ──────────────────────────────────────────────────────────────
OCR_SERVICE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
VITE_OCR_URL=http://localhost:8001

# ── Email (optional — set EMAIL_ENABLED=true to send emails) ──────────────────
EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── DO NOT commit real values of this file ────────────────────────────────────
# Copy to .env and fill in real values. .env is in .gitignore.
